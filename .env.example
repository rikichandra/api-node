# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Replace this value. Never commit your actual .env.
API_KEYS={"internal":"REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET"}
HOST=127.0.0.1
PORT=3108
DATA_DIR=./storage
WORKERS=1
MAX_PENDING_JOBS=50
MAX_PENDING_PER_CLIENT=10
MAX_STORED_JOBS=1000
RETENTION_DAYS=7
JOB_TIMEOUT_MS=1800000
UPSTREAM_COOLDOWN_MS=300000
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
# Windows: msedge. Linux/Docker: chromium.
SCRAPER_BROWSER=msedge
